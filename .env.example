# Proxmox
PROXMOX_HOST=192.168.1.100
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=changeme
PROXMOX_VERIFY_SSL=false
PROXMOX_MOCK=true

# NetBox
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=your_netbox_token_here

# Database (SQLite default; swap to postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./direttore.db

# API
# IMPORTANT: Add every hostname (and port) that your browser uses to access
# the frontend. Browsers enforce CORS — FastAPI will reject requests from
# any origin not listed here, causing silent API failures in the UI.
#
# Bare-metal behind nginx (no port needed if using 80/443):
#   API_CORS_ORIGINS=http://localhost:5173,https://direttore.example.com
#
# Local dev only:
#   API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Unimus (Pro) — required for hardware backup and golden-config provisioning
# Token created in: Unimus → Settings → Security → API access tokens
UNIMUS_URL=https://unimus.example.com
UNIMUS_TOKEN=your-unimus-api-token

# Git config repository — stores device configs as <hostname>.txt files
# Uses HTTPS + PAT auth. PAT needs repo read+write scope (GitHub/GitLab/Gitea).
GIT_CONFIG_REPO=https://github.com/your-org/network-configs.git
GIT_CONFIG_BRANCH=main
GIT_CONFIG_AUTH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Local clone path on the server running Direttore
GIT_CONFIG_LOCAL_PATH=/opt/direttore/config-repo
GIT_CONFIG_AUTHOR_NAME=Direttore
GIT_CONFIG_AUTHOR_EMAIL=direttore@localhost
