# Proxmox
PROXMOX_HOST=192.168.1.100
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=changeme
PROXMOX_VERIFY_SSL=false
PROXMOX_MOCK=true

# NetBox
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=your_netbox_token_here

# Database (SQLite default; swap to postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./direttore.db

# API
# IMPORTANT: Add every hostname (and port) that your browser uses to access
# the frontend. Browsers enforce CORS — FastAPI will reject requests from
# any origin not listed here, causing silent API failures in the UI.
#
# Bare-metal behind nginx (no port needed if using 80/443):
#   API_CORS_ORIGINS=http://localhost:5173,https://direttore.example.com
#
# Local dev only:
#   API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
