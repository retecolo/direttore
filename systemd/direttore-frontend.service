[Unit]
Description=Direttore Vite Frontend
After=network.target

[Service]
Type=simple
User=buraglio
Group=buraglio
WorkingDirectory=/opt/direttore/frontend

# Ensure npm and node are in the path
Environment="PATH=/usr/bin:/usr/local/bin:/opt/node/bin"

# vite.config.js sets host: '0.0.0.0' so Vite binds to all interfaces
# automatically. No --host flag needed.
ExecStart=/usr/bin/npm run dev

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
