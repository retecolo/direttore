# Leave VITE_API_URL empty (or unset) when running the Vite dev server directly.
# Vite's built-in proxy (vite.config.js) forwards /api/* to the FastAPI backend
# on the same host, so no absolute URL is needed.
#
# Only set this if you are serving the built frontend (npm run build) from a
# completely separate host/port and need Axios to point at the API explicitly:
#   VITE_API_URL=https://api.direttore.example.com
VITE_API_URL=
